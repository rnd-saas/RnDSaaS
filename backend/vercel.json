{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index.ts" },
    { "src": "^/api/ping$", "dest": "/api/ping.ts" },
    { "src": "^/api/env-check$", "dest": "/api/env-check.ts" },
    { "src": "^/api/(.*)$", "dest": "/api/index.ts" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["hkg1"]
}