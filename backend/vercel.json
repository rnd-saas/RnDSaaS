{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@22"
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/index" },
    { "src": "^/api/ping$", "dest": "/api/ping" },
    { "src": "^/api/env-check$", "dest": "/api/env-check" },
    { "src": "^/api/(.*)$", "dest": "/api/index" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["hkg1"]
}